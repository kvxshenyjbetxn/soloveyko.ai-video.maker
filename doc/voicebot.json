  "tags": [
    {
      "name": "tasks",
      "description": "Создание задач на синтез речи, проверка статуса и получение результатов. Workflow: `POST /tasks` → `GET /tasks/{id}/status` → `GET /tasks/{id}/result`."
    },
    {
      "name": "Image",
      "description": "Синхронная генерация изображений (v1). Запрос блокируется до готовности результата. Поддерживает create и edit."
    },
    {
      "name": "templates",
      "description": "Управление шаблонами настроек синтеза речи. Шаблоны создаются через Telegram-бота, API позволяет получить список и использовать UUID при создании задач."
    },
    {
      "name": "balance",
      "description": "Получение текущего баланса пользователя. Баланс расходуется при создании TTS-задач (1 символ = 1 единица)."
    },
    {
      "name": "Image Generation v2",
      "description": "Асинхронная генерация изображений (v2). Workflow: `POST /generate` → `GET /tasks/{id}/status` или SSE `/stream/status` → `GET /tasks/{id}/result` или `/download`. Поддерживает create и edit (multipart)."
    }
  ]
}
