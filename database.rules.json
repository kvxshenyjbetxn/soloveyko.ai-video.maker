{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['state','lastChanged']) && newData.child('state').isString() && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline') && (!newData.hasChild('name') || (newData.child('name').isString() && newData.child('name').val().length <= 64))"
          }
        }
      }
    }
  }
}
